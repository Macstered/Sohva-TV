    <string name="about_title">About, privacy and licences</string>
    <string name="about_subtitle">Public non-commercial release information</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_noncommercial">Sohva TV is being prepared for free, non-commercial distribution. The app contains no channels or media and is not an IPTV or sports-content provider.</string>
    <string name="about_privacy_title">On-device privacy</string>
    <string name="about_privacy_intro">Sohva TV uses no user account, analytics, advertising or telemetry sent to the developer.</string>
    <string name="about_privacy_local">IPTV credentials, API keys, viewing history and settings remain on the Android TV device. Secrets are protected with Android Keystore, and portable backups are encrypted with the user’s password.</string>
    <string name="about_privacy_network">The app connects only to IPTV services configured by the user and to enabled API-Sports, TMDB and TVmaze services. Those services receive the network request and IP address under their own policies.</string>
    <string name="about_privacy_cleartext">HTTP is allowed only for IPTV compatibility. An unencrypted connection can expose credentials and viewing activity to others on the same network.</string>
    <string name="about_privacy_retention">Local data remains until the user clears it or uninstalls the app. Metadata and sports caches expire automatically.</string>
    <string name="about_contact_title">Support and privacy contact</string>
    <string name="about_contact_body">Questions, privacy requests and issue reports: hello@luontra.fi</string>
    <string name="about_contact_email">Send email</string>
    <string name="about_providers_title">Data sources and rights</string>
    <string name="about_tmdb_notice">This product uses the TMDB API but is not endorsed or certified by TMDB. TMDB is optional and requires the user’s own credential.</string>
    <string name="about_tvmaze_notice">TVmaze data is used under CC BY-SA. Enriched information cards identify TVmaze as the source and link to the original record.</string>
    <string name="about_api_sports_notice">Sohva Sport uses the user’s own API-Sports key. Sports data, logos and trademarks may belong to leagues, clubs or other rights holders.</string>
    <string name="about_provider_rights">Sohva TV claims no ownership of provider data or images and is not endorsed by their owners. Public or commercial use may require separate permission; commercial release is blocked until licensing is resolved.</string>
    <string name="about_open_source_title">Open-source software</string>
    <string name="about_open_source_notice">Sohva TV uses AndroidX, Jetpack Compose, Media3, Room, DataStore, WorkManager, Kotlin, kotlinx.serialization, OkHttp, Coil, kXML2 and ZXing under their respective licences. The third-party notice accompanying a release lists the projects and licence links.</string>
    <string name="about_no_affiliation">Sohva TV is not an IPTV provider and is not affiliated with Google, TMDB, TVmaze, API-Sports, sports leagues or channel owners.</string>
